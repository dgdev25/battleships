# Browser game with a local vector-memory engine. The runtime has no secrets,
# no mounted volume, and no outbound provider configuration.
FROM node:22-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080 \
    BATTLE_SHOWCASE_MODE=true \
    BATTLE_DATA_DIR=/tmp/abyssal-memory

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node src ./src
COPY --chown=node:node public ./public

# The repository includes several owner-supplied MP3 recordings whose public
# redistribution licence has not been documented. They are deliberately not
# part of the hosted image; the client has Web Audio fallbacks and documented
# public-domain Ogg samples.
RUN rm -f public/audio/bomb-explosion.mp3 \
    public/audio/falling-bomb-whistle.mp3 \
    public/audio/ship-fire-rocket.mp3 \
    public/audio/ww2-sea-background.mp3 \
    public/audio/victory.mp3 \
    public/audio/defeat.mp3

USER node
EXPOSE 8080
CMD ["node", "src/server.mjs"]
